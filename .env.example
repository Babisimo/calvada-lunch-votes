# Copy to .env and fill in from Firebase console → Project settings → Your apps.
#
# NOTE: every VITE_ variable is inlined into the client bundle at build time and
# is therefore public by design. Firebase web config is not a secret — what
# actually protects your data is firestore.rules, not hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
