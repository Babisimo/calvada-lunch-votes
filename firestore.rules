rules_version = '2';

// =============================================================================
// Calvada Lunch Vote — Firestore security rules
// -----------------------------------------------------------------------------
// The app previously enforced everything in the browser, which meant anyone with
// a Google account and a devtools console could cast unlimited votes for any
// option, in any week. These rules move that enforcement server-side.
//
// Guarantees:
//   * Only verified @calvada.com accounts can vote.
//   * Exactly one vote per person per week, enforced by the document ID.
//   * A vote must name a choice that is actually on that week's ballot.
//   * Votes are immutable once cast; only admins can delete them.
//   * Only admins can touch the menu, the ballot, the week, or the timer.
//   * `winner` can only be set after voting closes, only to a name that was
//     actually on the ballot, and only once per voting window.
//
// BOOTSTRAP: isAdmin() reads /admins/{email}. If that collection is empty, no
// one is an admin and no one can create one. Seed the first admin document by
// hand in the Firebase console before deploying these rules.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Google returns the address already normalized, but lowercase defensively
    // so /admins document IDs only ever need to be stored lowercase.
    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isCalvada() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && userEmail().matches('^[^@]+@calvada[.]com$');
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(userEmail()));
    }

    function currentWeek() {
      return get(/databases/$(database)/documents/config/currentWeek).data.value;
    }

    function ballotChoices(week) {
      return get(/databases/$(database)/documents/weeklyOptions/$(week)).data.choices;
    }

    function votingConfig() {
      return get(/databases/$(database)/documents/config/votingConfig).data;
    }

    // The click battle for a week. Both helpers read the same document; Firestore
    // deduplicates identical get() paths within one rule evaluation, so this
    // costs one read, not two.
    function battleOptions(weekId) {
      return get(/databases/$(database)/documents/tieBreakers/$(weekId)).data.options;
    }

    function battleEndsAt(weekId) {
      return get(/databases/$(database)/documents/tieBreakers/$(weekId)).data.endsAt;
    }

    // The admin UI writes numeric startMs/endMs alongside the ISO strings so the
    // window can be checked here — rules cannot parse a datetime-local string.
    // If a config predates that change the check is skipped rather than locking
    // everyone out; re-saving the timer in the admin UI activates it.
    function withinVotingWindow() {
      let cfg = votingConfig();
      return !('startMs' in cfg)
        || !('endMs' in cfg)
        || (request.time.toMillis() >= cfg.startMs && request.time.toMillis() <= cfg.endMs);
    }

    function configEndMs() {
      let cfg = votingConfig();
      return 'endMs' in cfg ? cfg.endMs : 0;
    }

    function votingHasClosed() {
      return configEndMs() > 0 && request.time.toMillis() >= configEndMs();
    }

    // ---- votes --------------------------------------------------------------
    // Document ID is "{week}_{uid}". That is what makes double-voting
    // impossible: a second vote targets a path that already exists, which is an
    // update, and updates are denied outright.
    match /votes/{voteId} {
      allow read: if isCalvada() || isAdmin();

      allow create: if isCalvada()
        && withinVotingWindow()
        && voteId == currentWeek() + '_' + request.auth.uid
        && request.resource.data.week == currentWeek()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.choice is string
        && request.resource.data.choice in ballotChoices(currentWeek())
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- weeklyOptions ------------------------------------------------------
    // Two separate update paths (allow rules OR together):
    //   1. Admins manage `choices` but may not touch `winner`.
    //   2. Any verified voter may SET `winner` once, after the window closes.
    //
    // Path 2 exists because the winner is tallied in the browser — the first
    // client to load after closing time writes it. That is a deliberate
    // trade-off to avoid requiring the Blaze plan for Cloud Functions. It is
    // constrained so the worst case is bounded: the write must name a choice
    // that was actually on the ballot, must be stamped with the server's clock,
    // and cannot overwrite a decision already made for the same window. So a
    // winner cannot be invented, backdated, or flip-flopped — but a determined
    // insider could pick which of the real ballot options gets recorded.
    // Deploying functions/index.js and tightening path 2 to `if false` closes
    // that last gap.
    match /weeklyOptions/{weekId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        && !('winner' in request.resource.data);

      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['winner']);

      allow update: if isCalvada()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['winner'])
        && votingHasClosed()
        && request.resource.data.winner.name in resource.data.choices
        && request.resource.data.winner.decidedForEndMs == configEndMs()
        && request.resource.data.winner.decidedAt == request.time
        && (!('winner' in resource.data)
            || !('decidedForEndMs' in resource.data.winner)
            || resource.data.winner.decidedForEndMs != configEndMs());

      allow delete: if isAdmin();
    }

    // ---- menu ---------------------------------------------------------------
    match /menu/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- admins -------------------------------------------------------------
    // A signed-in user may read their OWN admin doc — that is how the app
    // decides whether to show the Admin link. Listing the roster is admin-only.
    match /admins/{adminEmail} {
      allow get: if isSignedIn() && (adminEmail == userEmail() || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- config -------------------------------------------------------------
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- tieBreakers (the click battle) — DORMANT ---------------------------
    // The click battle is built but NOT wired into the app; ties are settled by
    // the admin coin flip instead. See the header of src/components/ClickBattle.tsx.
    //
    // This block is left deployed so reviving the feature needs no rules change.
    // It is inert on its own: every click write reads the battle document via
    // get(), and nothing creates one now, so a missing battle doc fails the rule
    // and the write is denied. Safe to delete if the feature is abandoned.
    //
    // When a week closes level, an admin can start a timed click battle between
    // the tied options. Everyone piles onto a side; most clicks wins.
    //
    // Each player writes ONLY their own /clicks/{uid} document. A single shared
    // counter would hit Firestore's ~1 write/sec per-document ceiling the moment
    // two people mashed at once.
    //
    // Counts are absolute, not increments, specifically so these rules can check
    // them: an increment() is opaque here, an absolute number can be held to
    // monotonic growth and a rate cap. That bounds a forged count — it does not
    // make it honest. Anyone with devtools can still inflate within the cap.
    // Accepted, same as the winner-write gap above; it decides lunch.
    //
    // Writes are accepted for 2s PAST endsAt. Clicks are buffered client-side
    // and flushed on a timer, so the final flush necessarily lands after the
    // whistle — without the grace window the last half-second of everyone's
    // clicks would be thrown away, which decides exactly the close battles.
    // The client stops counting clicks at endsAt; this only lets the buffer land.
    match /tieBreakers/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /clicks/{uid} {
        allow read: if isSignedIn();

        // First write picks your side and creates the doc.
        allow create: if isCalvada()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['choice', 'count', 'updatedAt'])
          && request.resource.data.choice in battleOptions(weekId)
          && request.resource.data.count is int
          && request.resource.data.count > 0
          && request.resource.data.count <= 40
          && request.resource.data.updatedAt == request.time
          && request.time.toMillis() < battleEndsAt(weekId) + 2000;

        allow update: if isCalvada()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['choice', 'count', 'updatedAt'])
          // YOUR FIRST CLICK COMMITS YOU. Enforced here rather than in the UI so
          // switching sides late isn't a devtools trick.
          && request.resource.data.choice == resource.data.choice
          && request.resource.data.count is int
          && request.resource.data.count > resource.data.count
          && request.resource.data.count <= resource.data.count + 40
          && request.resource.data.updatedAt == request.time
          // 40 clicks per 350ms caps a script at ~114/sec. A fast human is ~10.
          && request.time.toMillis() >= resource.data.updatedAt.toMillis() + 350
          && request.time.toMillis() < battleEndsAt(weekId) + 2000;

        // No editing your own count downward, and no deleting a losing run.
        allow delete: if isAdmin();
      }
    }

    // ---- winners (legacy read model) ----------------------------------------
    match /winners/{weekId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Anything not matched above is denied.
  }
}
